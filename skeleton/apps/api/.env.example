{{#if sqlite}}
# SQLite database file. Paths are resolved relative to apps/api/.
# Falls back to `{{name}}.db` when unset.
DATABASE_URL={{name}}.db
{{else}}
# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{name}}
{{/if}}
{{#if useAuth}}
# Secret used by Auth.js to sign and encrypt session cookies. Required while
# authentication is enabled. Generate one with: openssl rand -base64 32
AUTH_SECRET=
{{/if}}
