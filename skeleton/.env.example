# Shared configuration for the whole monorepo, loaded from the repository
# root by both the API (dotenv) and the client (Vite).

# Port the API listens on.
API_PORT=3000

# Base URL of the API, used by the client's API client. Vite only exposes
# variables prefixed with VITE_ to client code.
VITE_API_URL=http://localhost:3000

# Origin the API accepts cross-origin requests from (the Vite dev server).
CLIENT_URL=http://localhost:5173
